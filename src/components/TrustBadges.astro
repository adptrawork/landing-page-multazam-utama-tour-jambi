---
const badges = [
  { t: 'PPIU 884/2019', d: 'Tertera di banner resmi' },
  { t: 'Est. 1999', d: '25+ tahun pengalaman' },
  { t: 'Muthowif sunnah', d: 'Bimbingan sesuai syariat' },
  { t: 'Rating 5.0/5', d: '200 ulasan jamaah' },
];
---
<!-- Ref: Shakuro Umrah&Hajj tour — trust badges row -->
<ul class="grid grid-cols-2 lg:grid-cols-4 gap-4 list-none">
  {badges.map((b) => (
    <li class="bg-white border border-amber-600/20 rounded-[1.5rem] p-5 text-center">
      <p class="font-editorial font-bold text-lg">{b.t}</p>
      <p class="mt-1 text-xs text-stone-500">{b.d}</p>
    </li>
  ))}
</ul>
