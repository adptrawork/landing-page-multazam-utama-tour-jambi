---
/* Itinerary ringkas gambaran umum — detail harian per paket dikonfirmasi via WA */
const plans = [
  { d: '9 hari', stops: ['H1 Tiba Madinah — thawaf qudum orientasi', 'H2–H3 Ziarah Madinah + Raudhah', 'H4 Hijrah ke Makkah — umroh wajib', 'H5–H7 Ibadah mandiri + ziarah Thaif (opsional)', 'H8 Umroh sunnah kedua', 'H9 Kepulangan ke Tanah Air'] },
  { d: '10 hari', stops: ['H1–H2 Tiba & istirahat Madinah', 'H3–H4 Ziarah Madinah + Raudhah', 'H5 Hijrah ke Makkah — umroh wajib', 'H6–H8 Ibadah + city tour Makkah', 'H9 Umroh sunnah + persiapan pulang', 'H10 Kepulangan ke Tanah Air'] },
  { d: '12 hari', stops: ['H1–H3 Madinah: adaptasi + ziarah', 'H4–H5 Raudhah + kajian sunnah', 'H6 Hijrah ke Makkah — umroh wajib', 'H7–H10 Ibadah mandiri + umroh sunnah', 'H11 Ziarah perpisahan + belanja', 'H12 Kepulangan ke Tanah Air'] },
];
---
<!-- Ref: Haramain agency — itinerary timeline vertikal (mobile-first) -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-5">
  {plans.map((plan) => (
    <div class="bg-white border border-amber-600/20 rounded-[2rem] p-6 md:p-7">
      <p class="font-mono-num text-sm font-semibold text-amber-700">{plan.d.toUpperCase()}</p>
      <ol class="mt-4 relative pl-6 space-y-4 list-none border-l-2 border-amber-600/20">
        {plan.stops.map((s) => (
          <li class="relative text-sm text-stone-600">
            <span aria-hidden="true" class="absolute -left-[31px] top-1 w-3 h-3 rounded-full bg-amber-600 border-2 border-white shadow"></span>
            {s}
          </li>
        ))}
      </ol>
    </div>
  ))}
</div>
<p class="mt-4 text-xs text-stone-400">Gambaran umum alur perjalanan — susunan harian resmi mengikuti tiap paket, minta via WA.</p>
