---
interface Pkg { name: string; hotel: string; price: string; status: string; img: string }
interface Props { p: Pkg; index: number; wa: string }
const { p, index, wa } = Astro.props;
const imgFile: Record<string, { f: string; w: number; h: number }> = {
  ajyad: { f: 'multazam-paket-ajyad-des.jpg', w: 900, h: 1125 },
  barokah: { f: 'multazam-paket-barokah.jpg', w: 900, h: 1125 },
  sofwah: { f: 'multazam-paket-sofwah.jpg', w: 900, h: 1125 },
  sohada: { f: 'multazam-paket-sohada.jpg', w: 900, h: 1125 },
  royal: { f: 'multazam-paket-royal.jpg', w: 900, h: 1125 },
  syawal: { f: 'multazam-paket-syawal.jpg', w: 648, h: 809 },
};
const img = imgFile[p.img] ?? { f: 'multazam-umroh-series.jpg', w: 1200, h: 900 };
const durasi = p.name.includes('12 Hari') ? '12 hari' : p.name.includes('10 Hari') ? '10 hari' : p.name.includes('15 Hari') ? '15 hari' : p.name.includes('9 Hari') ? '9 hari' : 'Lihat detail';
---
<!-- Ref: Shakuro Umrah&Hajj tour — paket cards + hotel/maskapai info -->
<article class="spotlight bg-white border border-amber-600/20 rounded-[2rem] overflow-hidden h-full flex flex-col transition duration-300 hover:-translate-y-1">
  <img src={`/images/${img.f}`} alt={`Banner resmi ${p.name} hotel ${p.hotel}`} width={img.w} height={img.h} loading={index < 2 ? 'eager' : 'lazy'} decoding="async" fetchpriority={index === 0 ? 'high' : 'auto'} class="w-full max-w-full aspect-[4/5] object-cover object-top" />
  <div class="p-6 flex flex-col gap-2 grow">
    <div class="flex items-center justify-between gap-3">
      <span class="font-mono-num text-xs font-semibold text-amber-700">PAKET 0{index + 1}</span>
      <span class="text-xs font-medium text-emerald-900 bg-emerald-900/10 px-3 py-1 rounded-full whitespace-nowrap">{p.status}</span>
    </div>
    <h3 class="font-editorial font-bold text-2xl leading-tight">{p.name}</h3>
    <dl class="text-sm space-y-1.5">
      <div class="flex justify-between gap-3"><dt class="text-stone-500">Hotel</dt><dd class="font-semibold text-right">{p.hotel}</dd></div>
      <div class="flex justify-between gap-3"><dt class="text-stone-500">Durasi</dt><dd class="font-mono-num font-semibold text-right">{durasi}</dd></div>
      <div class="flex justify-between gap-3"><dt class="text-stone-500">Harga mulai</dt><dd class="font-mono-num font-semibold text-amber-700 text-right">{p.price}</dd></div>
    </dl>
    <a href={wa} target="_blank" rel="noopener" class="mt-auto pt-2 text-center bg-amber-600 text-white px-6 py-3 rounded-full text-sm font-medium min-h-[48px] grid place-items-center transition duration-300 hover:-translate-y-0.5 active:scale-[0.97]">Detail via WA</a>
  </div>
</article>
