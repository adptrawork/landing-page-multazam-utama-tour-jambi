---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, testimonials } from '../data/business';
---
<BaseLayout title={`Kata jamaah haji & umroh — ${business.name}`} description="Testimoni jamaah Multazam: Zaskia Adya Mecca, Tantri Syalindri, Tya Ariestya, dan jamaah private. Rating 5.0." canonicalPath="/testimoni" image="/images/multazam-umroh-series.jpg">
  <section class="max-w-6xl mx-auto px-4 pt-12 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-end">
      <div class="md:col-span-7 reveal">
        <p class="text-sm font-medium text-amber-700">Testimoni</p>
        <h1 class="mt-2 font-editorial text-4xl md:text-6xl leading-none font-bold">Rating <span class="font-mono-num">{business.rating}</span> dari para jamaah</h1>
        <p class="mt-4 text-base text-stone-600 max-w-[65ch]">Kutipan di bawah berasal dari halaman testimoni situs resmi multazam.co.id.</p>
      </div>
      <div class="md:col-span-5 reveal">
        <img src="/images/multazam-umroh-series.jpg" alt="Suasana jamaah umroh Multazam di Tanah Suci" width="1200" height="900" loading="lazy" class="w-full h-56 object-cover rounded-[2rem] border border-amber-600/20" />
        <p class="mt-3 text-xs text-zinc-400">Sumber: multazam.co.id (situs resmi) — ganti foto asli</p>
      </div>
    </div>
  </section>
  <section class="max-w-6xl mx-auto px-4 py-10 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      {testimonials.map((t, i) => (
        <blockquote class:list={['reveal', i % 2 === 0 ? 'md:col-span-7' : 'md:col-span-5']}>
          <div class="bg-white border border-amber-600/20 rounded-[2rem] p-8 md:p-10 h-full">
            <p class="text-lg text-stone-600 leading-relaxed">"{t.text}"</p>
            <p class="mt-4 font-semibold">{t.name}</p>
            <p class="text-sm text-stone-500">{t.role}</p>
          </div>
        </blockquote>
      ))}
    </div>
    <div class="mt-10 md:pl-[12vw]">
      <a href={business.ctaUrl} target="_blank" rel="noopener" class="inline-block bg-teal-700 text-white px-8 py-3.5 rounded-full font-medium">Konsultasi Gratis via WA</a>
    </div>
  </section>
</BaseLayout>
