---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, packages, departures } from '../data/business';
const imgFile: Record<string, { f: string; w: number; h: number }> = {
  ajyad: { f: 'multazam-paket-ajyad-des.jpg', w: 900, h: 1125 },
  barokah: { f: 'multazam-paket-barokah.jpg', w: 900, h: 1125 },
  sofwah: { f: 'multazam-paket-sofwah.jpg', w: 900, h: 1125 },
  sohada: { f: 'multazam-paket-sohada.jpg', w: 900, h: 1125 },
  royal: { f: 'multazam-paket-royal.jpg', w: 900, h: 1125 },
  syawal: { f: 'multazam-paket-syawal.jpg', w: 648, h: 809 },
};
const order = ['sofwah', 'ajyad', 'barokah', 'sohada', 'royal', 'syawal'];
const sortedPkgs = [...packages].sort((a, b) => order.indexOf(a.img) - order.indexOf(b.img));
---
<BaseLayout title={`15 jadwal umroh Kautsar–Syawal — ${business.name}`} description="Semua paket Multazam Jambi: Kautsar 9–10 hari, Barokah ekonomis 12 hari, Ramadhan, Lailatul Qadar, Syawal. Hotel Sofwah Tower, Ajyad Makareem, maskapai Saudia." canonicalPath="/paket" image="/images/multazam-paket-sofwah.jpg" breadcrumbs={[{ name: 'Paket', path: '/paket' }]}>
  <section class="max-w-6xl mx-auto px-4 pt-12 w-full">
    <p class="text-xs font-semibold uppercase tracking-widest text-amber-700">Paket — 6 banner resmi + 9 jadwal</p>
    <h1 class="mt-2 font-editorial text-4xl md:text-6xl leading-none font-bold max-w-[22ch]">Pilih bulan hijriahmu, kami siapkan seatnya</h1>
    <p class="mt-4 text-base text-stone-600 max-w-[65ch]">Harga mulai (quad) dari multazam.co.id, maskapai Saudia. Kartu menumpuk saat digulir — tiap banner adalah materi resmi operator.</p>
    <p class="mt-4 font-mono-num text-sm text-amber-700 seat-blink">Slot Desember menipis — konfirmasi seat via WA hari ini.</p>
  </section>
  <section class="max-w-6xl mx-auto px-4 py-10 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      {sortedPkgs.map((p, i) => (
        <article class:list={['stack-card reveal', i % 2 === 0 ? 'md:col-span-7 md:col-start-1' : 'md:col-span-7 md:col-start-6']} style={`z-index:${i + 1};`}>
          <div class="spotlight bg-white border border-amber-600/20 rounded-[2rem] p-6 md:flex md:gap-6">
            <img src={`/images/${imgFile[p.img].f}`} alt={`Banner resmi ${p.name} hotel ${p.hotel}`} width={imgFile[p.img].w} height={imgFile[p.img].h} loading="lazy" class="w-full md:w-56 aspect-[4/5] object-cover object-top rounded-3xl shrink-0" />
            <div class="mt-4 md:mt-0">
              <p class="font-mono-num text-xs text-amber-700 font-semibold">PAKET 0{i + 1} / 06</p>
              <h2 class="mt-1 font-editorial font-bold text-2xl leading-tight">{p.name}</h2>
              <p class="text-sm text-stone-600">{p.hotel} — {p.status}</p>
              <p class="font-mono-num font-semibold mt-2 text-amber-700">Mulai {p.price}</p>
              <a href={`https://wa.me/${business.phone}?text=${encodeURIComponent(`Halo admin Multazam, saya mau tanya ${p.name} (${p.price}). Apakah seat masih ada?`)}`} target="_blank" rel="noopener" class="mt-4 inline-block bg-amber-600 text-white px-5 py-2.5 rounded-full text-xs font-medium transition duration-300 hover:-translate-y-0.5 active:scale-[0.97]">Tanya seat</a>
            </div>
          </div>
          <p class="mt-2 text-xs text-stone-400 px-2">Sumber banner: multazam.co.id.</p>
        </article>
      ))}
    </div>
  </section>
  <section class="max-w-6xl mx-auto px-4 py-8 w-full">
    <h2 class="font-editorial text-3xl font-bold">Sembilan keberangkatan lain</h2>
    <div class="mt-6 bg-white border border-amber-600/20 rounded-[2rem] overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm min-w-[640px]">
          <thead class="sticky top-16 bg-stone-900 text-stone-100">
            <tr class="text-left">
              <th class="py-3 px-5 font-medium">Program</th><th class="py-3 px-5 font-medium">Hotel</th><th class="py-3 px-5 font-medium">Harga mulai</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-amber-600/10">
            {departures.map((d, i) => (
              <tr class:list={['transition hover:bg-amber-600/5', i % 2 === 1 && 'bg-stone-100/70']}>
                <td class="py-3 px-5 font-semibold">{d.name}</td>
                <td class="py-3 px-5 text-stone-600">{d.hotel}</td>
                <td class="py-3 px-5 font-mono-num font-semibold whitespace-nowrap text-amber-700">{d.price}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <div class="mt-10">
      <a href={business.ctaUrl} target="_blank" rel="noopener" class="inline-block bg-amber-600 text-white px-8 py-3.5 rounded-full font-medium transition duration-300 hover:-translate-y-0.5 active:scale-[0.97]">Konsultasi Gratis via WA</a>
    </div>
  </section>
</BaseLayout>
