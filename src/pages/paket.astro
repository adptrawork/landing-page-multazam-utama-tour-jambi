---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, packages, departures, hotels } from '../data/business';
const badgeCls = (s: string) =>
  s.includes('Terverifikasi') ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800';
const imgFile: Record<string, { f: string; w: number; h: number }> = {
  ajyad: { f: 'multazam-paket-ajyad-des.jpg', w: 900, h: 1125 },
  barokah: { f: 'multazam-paket-barokah.jpg', w: 900, h: 1125 },
  sofwah: { f: 'multazam-paket-sofwah.jpg', w: 900, h: 1125 },
  sohada: { f: 'multazam-paket-sohada.jpg', w: 900, h: 1125 },
  royal: { f: 'multazam-paket-royal.jpg', w: 900, h: 1125 },
  syawal: { f: 'multazam-paket-syawal.jpg', w: 648, h: 809 },
};
const order = ['sofwah', 'ajyad', 'barokah', 'sohada', 'royal', 'syawal'];
const sortedPkgs = [...packages].sort((a, b) => order.indexOf(a.img) - order.indexOf(b.img));
---
<BaseLayout title={`Paket umroh — ${business.name}`} description="Paket umroh Multazam: Kautsar 9–10 hari, Barokah Ekonomis 12 hari, Ramadhan, Syawal. Hotel Sofwah Tower, Ajyad Makareem, Sohada, Royal Majestic." canonicalPath="/paket" image="/images/multazam-paket-sofwah.jpg">
  <section class="max-w-7xl mx-auto px-4 pt-12 w-full">
    <p class="text-sm font-medium text-teal-700">Paket</p>
    <h1 class="mt-2 text-4xl md:text-5xl tracking-tighter leading-none font-bold max-w-[20ch]">Paket umroh terverifikasi situs resmi</h1>
    <p class="mt-4 text-base text-gray-600 max-w-[65ch]">Harga mulai (quad) dari situs resmi multazam.co.id, maskapai Saudia. Banner di bawah adalah materi resmi operator — harga dapat berubah mengikuti kurs.</p>
  </section>
  <section class="max-w-7xl mx-auto px-4 py-10 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      {sortedPkgs.map((p, i) => (
        <article class:list={['reveal', i % 3 === 0 ? 'md:col-span-7' : 'md:col-span-5']}>
          <div class="bg-white border border-slate-200/50 rounded-[2.5rem] p-6 md:p-8 h-full">
            <img src={`/images/${imgFile[p.img].f}`} alt={`Banner resmi ${p.name} hotel ${p.hotel}`} width={imgFile[p.img].w} height={imgFile[p.img].h} loading="lazy" class="w-full aspect-[4/5] object-cover object-top rounded-3xl" />
            <p class="mt-4 text-xs font-medium"><span class={`px-3 py-1.5 rounded-full ${badgeCls(p.status)}`}>{p.status}</span></p>
            <h2 class="mt-2 font-semibold text-lg tracking-tight">{p.name}</h2>
            <p class="text-sm text-gray-600">{p.hotel}</p>
            <div class="mt-3 flex items-center justify-between">
              <p class="font-mono-num font-semibold">Mulai {p.price}</p>
              <a href={`https://wa.me/${business.phone}?text=${encodeURIComponent(`Halo admin Multazam, saya mau tanya ${p.name} (${p.price}). Apakah seat masih ada?`)}`} target="_blank" rel="noopener" class="bg-zinc-950 text-white px-5 py-2.5 rounded-full text-xs font-medium">Tanya seat</a>
            </div>
          </div>
          <p class="mt-3 text-xs text-zinc-400 px-2">Sumber banner: multazam.co.id — ganti foto asli.</p>
        </article>
      ))}
    </div>
  </section>
  <section class="max-w-7xl mx-auto px-4 py-8 w-full">
    <h2 class="text-2xl md:text-3xl tracking-tighter font-bold">Keberangkatan lain</h2>
    <div class="mt-6 bg-white border border-slate-200/50 rounded-[2.5rem] p-4 md:p-8 overflow-x-auto">
      <table class="w-full text-sm min-w-[640px]">
        <thead><tr class="text-left text-zinc-500 border-b border-zinc-200">
          <th class="py-3 px-4 font-medium">Program</th><th class="py-3 px-4 font-medium">Hotel</th><th class="py-3 px-4 font-medium">Harga mulai</th>
        </tr></thead>
        <tbody class="divide-y divide-zinc-100">
          {departures.map((d) => (
            <tr class="hover:bg-zinc-50/70">
              <td class="py-3 px-4 font-semibold">{d.name}</td>
              <td class="py-3 px-4 text-gray-600">{d.hotel}</td>
              <td class="py-3 px-4 font-mono-num font-semibold whitespace-nowrap">{d.price}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
  <section class="max-w-7xl mx-auto px-4 py-8 w-full">
    <h2 class="text-2xl md:text-3xl tracking-tighter font-bold">Hotel yang digunakan</h2>
    <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-12 gap-6">
      {hotels.map((h, i) => (
        <div class:list={['reveal', i < 2 ? 'md:col-span-7 md:[&:nth-child(2)]:col-span-5' : i % 2 === 0 ? 'md:col-span-5' : 'md:col-span-7']}>
          <div class="bg-white border border-slate-200/50 rounded-[2.5rem] p-8 h-full">
            <h3 class="font-semibold text-lg tracking-tight">{h.name}</h3>
            <p class="mt-1 text-sm text-gray-600">{h.desc}</p>
          </div>
        </div>
      ))}
    </div>
    <div class="mt-10 md:pl-[12vw]">
      <a href={business.ctaUrl} target="_blank" rel="noopener" class="inline-block bg-teal-700 text-white px-8 py-3.5 rounded-full font-medium">Konsultasi Gratis via WA</a>
    </div>
  </section>
</BaseLayout>
