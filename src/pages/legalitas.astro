---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business } from '../data/business';
---
<BaseLayout title={`Legalitas PT Tisaga & izin 884/2019 — ${business.name}`} description="Legalitas Multazam Jambi: PT Tisaga Multazam Utama est. 15 Juli 1999, pendiri H. Imam Bashori, izin umroh 884/2019. Verifikasi di simpu Kemenag." canonicalPath="/legalitas" image="/images/multazam-muthawif-1.jpg" breadcrumbs={[{ name: 'Legalitas', path: '/legalitas' }]}>
  <section class="max-w-7xl mx-auto px-4 pt-12 md:pt-20 w-full">
    <p class="text-xs font-semibold uppercase tracking-widest text-amber-700">Legalitas</p>
    <h1 class="mt-2 font-editorial text-4xl md:text-6xl leading-none font-bold max-w-[22ch]">Cek dulu berkasnya, baru titip amanah</h1>
    <p class="mt-4 text-base text-stone-600 max-w-[65ch]">Kami tampilkan data apa adanya. Tanpa klaim garansi visa — yang kami janjikan proses sesuai ketentuan dan pendampingan penuh.</p>
  </section>
  <section class="max-w-7xl mx-auto px-4 py-10 md:py-12 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
      <div class="md:col-span-7 reveal">
        <div class="spotlight bg-white border border-amber-600/20 rounded-[2rem] p-8 h-full">
          <h2 class="font-editorial font-bold text-2xl">Badan hukum & izin</h2>
          <dl class="mt-4 space-y-3 text-sm">
            <div class="flex justify-between gap-4 border-b border-amber-600/10 pb-3"><dt class="text-stone-500">Badan hukum</dt><dd class="font-semibold text-right">{business.legalEntity}</dd></div>
            <div class="flex justify-between gap-4 border-b border-amber-600/10 pb-3"><dt class="text-stone-500">Berdiri</dt><dd class="font-semibold text-right">{business.founded} — {business.founder}</dd></div>
            <div class="flex justify-between gap-4 border-b border-amber-600/10 pb-3"><dt class="text-stone-500">Izin umroh</dt><dd class="font-semibold text-right">{business.izinUmroh}</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-stone-500">Kantor pusat</dt><dd class="text-right text-stone-600">Jl. Cempaka Putih Tengah 27 No.14A, Jakarta Pusat 10510</dd></div>
          </dl>
        </div>
      </div>
      <div class="md:col-span-5 reveal reveal-d1">
        <div class="spotlight bg-emerald-900 text-emerald-50 rounded-[2rem] p-8 h-full">
          <p class="text-xs font-semibold tracking-widest uppercase text-emerald-200">Badge izin terverifikasi</p>
          <p class="mt-2 font-mono-num text-2xl font-semibold">884 / 2019</p>
          <p class="mt-2 text-sm text-emerald-100/90">Nomor izin umroh pada banner resmi. Salinan SK tersedia via WA.</p>
          <a href="/cara-cek-izin" class="mt-5 inline-block bg-white text-emerald-900 px-6 py-3 rounded-full text-sm font-semibold transition duration-300 hover:-translate-y-0.5 active:scale-[0.97]">Cara cek izin sendiri</a>
        </div>
      </div>
      <div class="md:col-span-12 reveal">
        <div class="spotlight bg-white border border-amber-600/20 rounded-[2rem] p-8 md:grid md:grid-cols-12 md:gap-6 md:items-center">
          <img src="/images/multazam-muthawif-1.jpg" alt="Profil muthowif H. Permadi Rastiko, 9 tahun pengalaman membimbing jamaah" width="1200" height="375" decoding="async" loading="lazy" class="w-full max-w-full md:col-span-5 h-56 object-cover rounded-3xl" />
          <div class="md:col-span-7 mt-4 md:mt-0">
            <h2 class="font-editorial font-bold text-2xl">Bimbingan muthowif berpengalaman</h2>
            <p class="mt-1 text-sm text-stone-600 max-w-[65ch]">Contoh: H. Permadi Rastiko — lulusan Wali Barokah Kediri, 9 tahun ilmu Al-Qur'an dan Al-Hadist, 5 tahun muthowif, komunikatif berbahasa Arab.</p>
            <p class="mt-3 text-xs text-stone-400">Sumber: multazam.co.id (situs resmi).</p>
          </div>
        </div>
      </div>
    </div>
    <div class="mt-10">
      <a href={business.ctaUrl} target="_blank" rel="noopener" class="inline-block bg-amber-600 text-white px-8 py-3.5 rounded-full font-medium transition duration-300 hover:-translate-y-0.5 active:scale-[0.97]">Minta Bukti Izin via WA</a>
    </div>
  </section>
</BaseLayout>
