---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business } from '../data/business';
---
<BaseLayout title={`Legalitas & profil — ${business.name}`} description="Legalitas Multazam: PT Tisaga Multazam Utama est. 1999, izin umroh 884/2019, pendiri H. Imam Bashori. Cara verifikasi izin via WA dan simpu Kemenag." canonicalPath="/legalitas" image="/images/multazam-muthawif-1.jpg">
  <section class="max-w-7xl mx-auto px-4 pt-12 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-end">
      <div class="md:col-span-7 reveal">
        <p class="text-sm font-medium text-teal-700">Legalitas</p>
        <h1 class="mt-2 text-4xl md:text-5xl tracking-tighter leading-none font-bold">Cek dulu, baru percaya</h1>
        <p class="mt-4 text-base text-gray-600 max-w-[65ch]">Kami menampilkan data legalitas apa adanya. Tidak ada klaim garansi visa — yang kami janjikan adalah proses sesuai ketentuan dan pendampingan penuh.</p>
      </div>
      <div class="md:col-span-5 reveal">
        <img src="/images/multazam-hero-1.jpg" alt="Ilustrasi Kaabah dan jamaah haji Multazam Utama Tour" width="430" height="423" loading="lazy" class="w-full h-56 object-cover rounded-[2.5rem] border border-slate-200/50" />
        <p class="mt-3 text-xs text-zinc-400">Sumber: multazam.co.id (situs resmi) — ganti foto asli</p>
      </div>
    </div>
  </section>
  <section class="max-w-7xl mx-auto px-4 py-10 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      <div class="md:col-span-7 reveal"><div class="bg-white border border-slate-200/50 rounded-[2.5rem] p-8 md:p-10 h-full">
        <h2 class="font-semibold text-lg tracking-tight">Badan hukum & izin</h2>
        <dl class="mt-4 space-y-3 text-sm">
          <div class="flex justify-between gap-4 border-b border-zinc-100 pb-3"><dt class="text-zinc-500">Badan hukum</dt><dd class="font-semibold text-right">{business.legalEntity}</dd></div>
          <div class="flex justify-between gap-4 border-b border-zinc-100 pb-3"><dt class="text-zinc-500">Berdiri</dt><dd class="font-semibold text-right">{business.founded} — pendiri {business.founder}</dd></div>
          <div class="flex justify-between gap-4 border-b border-zinc-100 pb-3"><dt class="text-zinc-500">Izin umroh</dt><dd class="font-semibold text-right">{business.izinUmroh}</dd></div>
          <div class="flex justify-between gap-4"><dt class="text-zinc-500">Kantor pusat</dt><dd class="text-right text-gray-600">Jl. Cempaka Putih Tengah 27 No.14A, Jakarta Pusat 10510</dd></div>
        </dl>
      </div></div>
      <div class="md:col-span-5 reveal"><div class="bg-zinc-950 text-white rounded-[2.5rem] p-8 md:p-10 h-full">
        <h2 class="font-semibold text-lg tracking-tight">Cara verifikasi sendiri</h2>
        <ol class="mt-4 space-y-3 text-sm text-zinc-300 list-decimal list-inside">
          <li>Minta salinan SK izin via WA.</li>
          <li>Cek nomor izin di simpu.kemenag.go.id.</li>
          <li>Konfirmasi alamat kemitraan Jambi sebelum survei.</li>
          <li>Minta kwitansi resmi untuk setiap pembayaran.</li>
        </ol>
      </div></div>
      <div class="md:col-span-12 reveal"><div class="bg-white border border-slate-200/50 rounded-[2.5rem] p-8 md:p-10">
        <img src="/images/multazam-muthawif-1.jpg" alt="Profil muthowif H. Permadi Rastiko, 9 tahun pengalaman membimbing jamaah" width="1200" height="375" loading="lazy" class="w-full h-56 object-cover rounded-3xl" />
        <h2 class="mt-4 font-semibold text-lg tracking-tight">Bimbingan muthowif berpengalaman</h2>
        <p class="mt-1 text-base text-gray-600 max-w-[65ch]">Contoh: H. Permadi Rastiko — lulusan Wali Barokah Kediri, 9 tahun menyampaikan ilmu Al-Qur'an dan Al-Hadist, 5 tahun sebagai muthowif, komunikatif berbahasa Arab.</p>
        <p class="mt-3 text-xs text-zinc-400">Sumber: multazam.co.id (situs resmi) — ganti foto asli</p>
      </div></div>
    </div>
    <div class="mt-10 md:pl-[12vw]">
      <a href={business.ctaUrl} target="_blank" rel="noopener" class="inline-block bg-teal-700 text-white px-8 py-3.5 rounded-full font-medium">Minta Bukti Izin via WA</a>
    </div>
  </section>
</BaseLayout>
