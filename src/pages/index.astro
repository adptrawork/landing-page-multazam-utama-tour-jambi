---
import BaseLayout from '../layouts/BaseLayout.astro';
import PackageCard from '../components/PackageCard.astro';
import TimelineItinerary from '../components/TimelineItinerary.astro';
import ChecklistSyarat from '../components/ChecklistSyarat.astro';
import TrustBadges from '../components/TrustBadges.astro';
import Faq from '../components/Faq.astro';
import { business, packages, hotels, testimonials } from '../data/business';
const cta = business.ctaUrl;
const waPkg = (name: string, price: string) => `https://wa.me/${business.phone}?text=${encodeURIComponent(`Halo admin Multazam, saya mau tanya ${name} (${price}). Apakah seat masih ada?`)}`;
const faqs = [
  { q: 'Berapa DP untuk mengunci seat?', a: 'Besaran DP dan skema cicilan mengikuti tiap paket — tanyakan nominal dan jadwal pelunasan via WA sebelum transfer.' },
  { q: 'Syarat paspor seperti apa?', a: 'Umumnya paspor aktif min. 7 bulan sebelum keberangkatan. Admin membantu cek dan pengurusan bagi yang belum punya.' },
  { q: 'Apakah ada pendampingan dari Jambi?', a: 'Jamaah dibimbing muthowif berpengalaman sesuai sunnah; teknis keberangkatan dari Jambi (transit) dikonfirmasi via WA.' },
  { q: 'Bagaimana refund jika batal?', a: 'Ketentuan refund mengikuti maskapai dan hotel — minta kebijakan tertulis via WA sebelum membayar.' },
  { q: 'Bagaimana cara yakin travel ini resmi?', a: 'Minta salinan SK Izin Umroh 884/2019 via WA, lalu verifikasi di simpu.kemenag.go.id — panduannya di halaman Cara Cek Izin.' },
];
---
<BaseLayout title={business.title} description={business.description} canonicalPath={business.canonicalPath} image={business.ogImage}>
  <!-- Ref: luxury sites — 01 Hero tipografi mewah + whitespace, PPIU badge + harga mulai + CTA -->
  <section class="max-w-7xl mx-auto px-4 w-full overflow-hidden">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 py-12 md:py-20">
      <div class="md:col-span-5 md:pt-10 reveal md:pr-2 relative z-10">
        <p class="font-arabic text-xl text-amber-700" lang="ar">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</p>
        <p class="mt-3 inline-flex items-center gap-2 text-xs font-semibold tracking-widest uppercase text-emerald-900 bg-emerald-900/10 border border-emerald-900/25 rounded-full px-4 py-1.5">PPIU 884/2019 — amanah sejak 1999</p>
        <h1 class="mt-4 font-editorial text-4xl md:text-6xl leading-[1.02] font-bold">Umroh tenang, dibimbing sesuai sunnah</h1>
        <p class="mt-5 text-base text-stone-600 leading-relaxed max-w-[55ch]">PT Tisaga Multazam Utama — paket mulai <strong class="font-mono-num text-amber-700">Rp32 juta</strong>, hotel Sofwah Tower dan Ajyad Makareem, muthowif profesional.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={cta} target="_blank" rel="noopener" class="bg-amber-600 text-white px-7 py-3.5 rounded-full font-medium min-h-[48px] inline-flex items-center transition duration-300 hover:-translate-y-0.5 active:scale-[0.97]">Konsultasi Gratis via WA</a>
          <a href="/paket" class="border border-amber-600/40 text-amber-700 px-7 py-3.5 rounded-full font-medium min-h-[48px] inline-flex items-center transition duration-300 hover:-translate-y-0.5 active:scale-[0.97]">Lihat Paket</a>
        </div>
        <dl class="mt-8 flex divide-x divide-amber-600/20 border-t border-amber-600/20 pt-5 text-sm">
          <div class="pr-6"><dd class="font-mono-num font-semibold text-lg">1999</dd><dd class="text-stone-500">Berdiri</dd></div>
          <div class="px-6"><dd class="font-mono-num font-semibold text-lg">884/19</dd><dd class="text-stone-500">Izin Umroh</dd></div>
          <div class="pl-6"><dd class="font-mono-num font-semibold text-lg">15+</dd><dd class="text-stone-500">Jadwal</dd></div>
        </dl>
      </div>
      <div class="md:col-span-7 reveal reveal-d1 md:-ml-10">
        <div class="overflow-hidden rounded-[2rem] border border-amber-600/20">
          <img src="/images/multazam-umroh-series.jpg" alt="Jamaah umroh Multazam di Tanah Suci" width="1200" height="900" loading="eager" fetchpriority="high" decoding="async" class="haramain-fade haramain-slow w-full max-w-full aspect-[16/11] object-cover" />
        </div>
        <p class="mt-3 text-xs text-stone-400">Sumber: multazam.co.id (situs resmi).</p>
      </div>
    </div>
  </section>

  <!-- Ref: Shakuro — 02 Legalitas strip -->
  <section class="max-w-7xl mx-auto px-4 w-full">
    <div class="bg-emerald-900 text-emerald-50 rounded-[2rem] p-6 md:p-8 md:flex md:items-center md:gap-8">
      <div class="flex flex-wrap gap-x-8 gap-y-3 font-mono-num text-sm grow">
        <p><span class="text-emerald-200 text-xs block tracking-widest">PPIU</span><strong>884 / 2019</strong></p>
        <p><span class="text-emerald-200 text-xs block tracking-widest">BADAN HUKUM</span><strong>PT Tisaga</strong></p>
        <p><span class="text-emerald-200 text-xs block tracking-widest">AKREDITASI & PIHK</span><strong>Konfirmasi WA</strong></p>
      </div>
      <a href="/cara-cek-izin" class="mt-4 md:mt-0 shrink-0 inline-flex items-center bg-white text-emerald-900 px-6 py-3 rounded-full text-sm font-semibold min-h-[48px] transition duration-300 hover:-translate-y-0.5 active:scale-[0.97]">Cek izin sendiri</a>
    </div>
  </section>

  <!-- Ref: Shakuro — 03 Paket cards -->
  <section class="max-w-7xl mx-auto px-4 py-12 md:py-20 w-full">
    <div class="flex items-end justify-between gap-4">
      <h2 class="font-editorial text-3xl md:text-4xl font-bold">Paket yang paling dicari</h2>
      <a href="/paket" class="text-sm font-medium text-amber-700 underline underline-offset-4 shrink-0">Semua 15 jadwal</a>
    </div>
    <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {packages.slice(0, 3).map((p, i) => (<PackageCard p={p} index={i} wa={waPkg(p.name, p.price)} />))}
    </div>
  </section>

  <!-- Ref: Haramain agency — 04 Itinerary ringkas -->
  <section class="max-w-7xl mx-auto px-4 py-12 md:py-20 w-full">
    <p class="text-xs font-semibold uppercase tracking-widest text-amber-700">Itinerary ringkas</p>
    <h2 class="mt-2 font-editorial text-3xl md:text-4xl font-bold">Gambaran 9 / 10 / 12 hari</h2>
    <div class="mt-6"><TimelineItinerary /></div>
  </section>

  <!-- Ref: Shakuro — 05 Hotel & maskapai badges -->
  <section class="max-w-7xl mx-auto px-4 py-12 md:py-20 w-full">
    <p class="text-xs font-semibold uppercase tracking-widest text-amber-700">Hotel & maskapai</p>
    <h2 class="mt-2 font-editorial text-3xl md:text-4xl font-bold">Tidur dekat, terbang nyaman</h2>
    <ul class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 list-none">
      {hotels.map((h) => (
        <li class="bg-white border border-amber-600/20 rounded-[1.5rem] p-5">
          <p class="flex items-center justify-between gap-3 font-semibold">{h.name}<span class="text-xs font-medium text-emerald-900 bg-emerald-900/10 px-3 py-1 rounded-full whitespace-nowrap">Terverifikasi</span></p>
          <p class="mt-1 text-sm text-stone-600">{h.desc}</p>
        </li>
      ))}
      <li class="bg-stone-900 text-stone-100 rounded-[1.5rem] p-5">
        <p class="flex items-center justify-between gap-3 font-semibold">Maskapai Saudia<span class="text-xs font-medium text-amber-300 bg-amber-600/20 px-3 py-1 rounded-full whitespace-nowrap">Estimasi</span></p>
        <p class="mt-1 text-sm text-stone-400">Maskapai mengikuti tiap keberangkatan — konfirmasi via WA.</p>
      </li>
    </ul>
  </section>

  <!-- Ref: Haramain agency — 06 Syarat dokumen -->
  <section class="max-w-7xl mx-auto px-4 py-12 md:py-20 w-full">
    <p class="text-xs font-semibold uppercase tracking-widest text-amber-700">Syarat dokumen</p>
    <h2 class="mt-2 font-editorial text-3xl md:text-4xl font-bold">Siapkan enam berkas ini</h2>
    <div class="mt-6"><ChecklistSyarat /></div>
  </section>

  <!-- Ref: Haramain agency — 07 Cara cek izin + testimoni + FAQ + kontak -->
  <section class="max-w-7xl mx-auto px-4 py-12 md:py-20 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
      <div class="md:col-span-7 bg-emerald-900 text-emerald-50 rounded-[2rem] p-8">
        <p class="text-xs font-semibold tracking-widest uppercase text-emerald-200">Cara cek izin — 5 langkah</p>
        <h2 class="mt-1 font-editorial text-2xl font-bold">Lima menit cek izin, dana puluhan juta aman</h2>
        <ol class="mt-4 space-y-2.5 text-sm list-none">
          <li class="flex gap-3"><span class="font-mono-num text-emerald-200">01</span> Minta salinan SK 884/2019 via WA</li>
          <li class="flex gap-3"><span class="font-mono-num text-emerald-200">02</span> Verifikasi di SIMPU Kemenag</li>
          <li class="flex gap-3"><span class="font-mono-num text-emerald-200">03</span> Pantau paket di Siskopatuh</li>
          <li class="flex gap-3"><span class="font-mono-num text-emerald-200">04</span> Konfirmasi kemitraan Jambi</li>
          <li class="flex gap-3"><span class="font-mono-num text-emerald-200">05</span> Minta kwitansi resmi PT</li>
        </ol>
        <a href="/cara-cek-izin" class="mt-6 inline-flex items-center bg-white text-emerald-900 px-6 py-3 rounded-full text-sm font-semibold min-h-[48px] transition duration-300 hover:-translate-y-0.5 active:scale-[0.97]">Panduan lengkap + tombol Kemenag</a>
      </div>
      <div class="md:col-span-5 bg-white border border-amber-600/20 rounded-[2rem] p-8">
        <p class="text-xs font-semibold tracking-widest uppercase text-amber-700">Testimoni</p>
        <h2 class="mt-1 font-editorial text-2xl font-bold">Rating <span class="font-mono-num">5.0</span> dari jamaah</h2>
        <blockquote class="mt-3 text-sm text-stone-600 leading-relaxed">"{testimonials[0].text}"</blockquote>
        <p class="mt-2 text-sm font-semibold">{testimonials[0].name}</p>
        <p class="text-xs text-stone-500">{testimonials[0].role}</p>
        <a href="/testimoni" class="mt-5 inline-flex items-center border border-amber-600/40 text-amber-700 px-6 py-3 rounded-full text-sm font-medium min-h-[48px] transition duration-300 hover:-translate-y-0.5 active:scale-[0.97]">Semua testimoni</a>
      </div>
    </div>
    <div class="mt-10 grid grid-cols-1 md:grid-cols-12 gap-6">
      <div class="md:col-span-7">
        <h2 class="font-editorial text-3xl font-bold">Sering ditanyakan</h2>
        <div class="mt-4 bg-white border border-amber-600/20 rounded-[2rem] px-6 md:px-8">
          <Faq items={faqs} />
        </div>
      </div>
      <div class="md:col-span-5">
        <h2 class="font-editorial text-3xl font-bold">Kontak 2 kantor</h2>
        <div class="mt-4 bg-stone-900 text-stone-100 rounded-[2rem] p-8">
          <h3 class="text-xs font-semibold tracking-widest uppercase text-amber-300">Kantor pusat</h3>
          <p class="mt-2 text-sm text-stone-300">Jl. Cempaka Putih Tengah 27 No.14A, Jakarta Pusat 10510 — (021) 4288-5027</p>
          <h3 class="mt-6 text-xs font-semibold tracking-widest uppercase text-amber-300">Layanan Jambi</h3>
          <p class="mt-2 text-sm text-stone-300">Kemitraan/cabang Jambi — alamat dikonfirmasi via WA sebelum survei.</p>
          <p class="mt-4 font-mono-num font-semibold">{business.phoneDisplay}</p>
          <a href={cta} target="_blank" rel="noopener" class="mt-5 grid place-items-center bg-amber-600 text-white px-6 py-3 rounded-full text-sm font-medium min-h-[48px] transition duration-300 hover:-translate-y-0.5 active:scale-[0.97]">{business.ctaLabel}</a>
        </div>
      </div>
    </div>
    <div class="mt-10">
      <TrustBadges />
    </div>
  </section>
</BaseLayout>
