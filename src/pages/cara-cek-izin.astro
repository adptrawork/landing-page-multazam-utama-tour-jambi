---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business } from '../data/business';
const steps = [
  { t: 'Minta salinan SK izin via WA', d: 'Admin wajib menunjukkan SK Izin Umroh No. 884/2019 atas nama PT Tisaga Multazam Utama. Simpan PDF-nya.' },
  { t: 'Cek di SIMPU Kemenag', d: 'Buka simpu.kemenag.go.id, masukkan nama travel atau nomor izin. Pastikan status aktif dan nama badan hukum sama persis.' },
  { t: 'Cek Siskopatuh paketmu', d: 'Setelah daftar, minta nomor porsi/registrasi dan pantau di Siskopatuh — memastikan seat, hotel, dan maskapai tercatat resmi.' },
  { t: 'Konfirmasi kemitraan Jambi', d: 'Alamat cabang/kemitraan Jambi dikonfirmasi via WA sebelum survei kantor. Jangan transfer ke rekening pribadi.' },
  { t: 'Minta kwitansi resmi', d: 'Setiap pembayaran wajib berkwitansi kop PT Tisaga Multazam Utama dengan nomor berurutan.' },
];
---
<BaseLayout title={`Cara cek izin umroh di Kemenag — ${business.name}`} description="Panduan cek izin Multazam: verifikasi izin umroh 884/2019 di simpu.kemenag.go.id, pantau paket di Siskopatuh, konfirmasi kemitraan Jambi." canonicalPath="/cara-cek-izin" image="/images/multazam-hero-1.jpg" breadcrumbs={[{ name: 'Cara Cek Izin', path: '/cara-cek-izin' }]}>
  <section class="max-w-6xl mx-auto px-4 pt-12 w-full">
    <p class="text-xs font-semibold uppercase tracking-widest text-amber-700">Panduan jamaah</p>
    <h1 class="mt-2 font-editorial text-4xl md:text-6xl leading-none font-bold max-w-[22ch]">Lima menit cek izin, dana puluhan juta aman</h1>
    <p class="mt-4 text-base text-stone-600 max-w-[65ch]">Jangan percaya brosur saja. Ikuti lima langkah resmi Kementerian Agama ini sebelum menyetor dana umroh ke travel mana pun — termasuk kami.</p>
  </section>
  <section class="max-w-6xl mx-auto px-4 py-10 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
      <ol class="md:col-span-7 space-y-4 list-none">
        {steps.map((s, i) => (
          <li class="reveal spotlight bg-white border border-amber-600/20 rounded-[1.75rem] p-6 flex gap-5">
            <span class="font-mono-num font-semibold text-amber-700 text-lg shrink-0">0{i + 1}</span>
            <div>
              <h2 class="font-editorial font-bold text-xl">{s.t}</h2>
              <p class="mt-1 text-sm text-stone-600">{s.d}</p>
            </div>
          </li>
        ))}
      </ol>
      <aside class="md:col-span-5">
        <div class="md:sticky md:top-24 space-y-4">
          <div class="bg-stone-900 text-stone-100 rounded-[1.75rem] p-7">
            <p class="text-xs font-semibold tracking-widest uppercase text-amber-300">Tautan resmi Kemenag</p>
            <div class="mt-4 flex flex-col gap-3 text-sm">
              <a href="https://simpu.kemenag.go.id" target="_blank" rel="noopener" class="bg-amber-600 text-white text-center px-5 py-3 rounded-full font-medium transition duration-300 hover:-translate-y-0.5 active:scale-[0.97]">Buka SIMPU Kemenag</a>
              <a href="https://siskopatuh.kemenag.go.id" target="_blank" rel="noopener" class="border border-white/25 text-center px-5 py-3 rounded-full font-medium transition duration-300 hover:-translate-y-0.5 active:scale-[0.97]">Buka Siskopatuh</a>
            </div>
            <p class="mt-4 text-xs text-stone-400">SIMPU: cek izin travel. Siskopatuh: pantau paket, hotel, dan maskapaimu setelah terdaftar.</p>
          </div>
          <div class="bg-emerald-900 text-emerald-50 rounded-[1.75rem] p-7">
            <p class="text-xs font-semibold tracking-widest uppercase text-emerald-200">Izin kami</p>
            <p class="mt-1 font-mono-num font-semibold">Umroh No. 884/2019</p>
            <a href={business.ctaUrl} target="_blank" rel="noopener" class="mt-4 inline-block bg-white text-emerald-900 px-5 py-2.5 rounded-full text-sm font-semibold transition duration-300 hover:-translate-y-0.5 active:scale-[0.97]">Minta salinan SK via WA</a>
          </div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
